{
  "name": "@elizaos/plugin-sentiment-analyzer",
  "version": "0.1.0",
  "description": "Sentiment analysis plugin for tracking ai16z & elizaOS sentiment across social media",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "sentiment",
    "analysis",
    "ai16z",
    "elizaos",
    "social",
    "twitter"
  ],
  "repository": {
    "type": "git",
    "url": ""
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@elizaos/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "8.5.0",
    "typescript": "^5.6.3"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "prettier --write ./src",
    "type-check": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  }
}
