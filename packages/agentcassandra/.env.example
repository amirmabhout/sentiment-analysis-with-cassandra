### Agent Cassandra Environment Variables ###
# To get started, copy this file to .env and configure the required settings
# This is a specialized ElizaOS agent configuration for the Cassandra project

### ⚠️  LEGAL DISCLAIMER - READ BEFORE USING ###
# This software can be configured to use third-party Twitter data services
# that may violate Twitter's Terms of Service. Users are solely responsible
# for ensuring compliance with all applicable Terms of Service.
# Consider using official Twitter API for production use.
# This software is provided for educational and research purposes.
###

### LOGGING CONFIGURATION ###
# Logging Configuration (supported: fatal, error, warn, info, debug, trace | default: info)
LOG_LEVEL=debug

### DATABASE CONFIGURATION ###
# By default, Eliza will use a local pglite instance
# Uncomment and configure PGLITE_DATA_DIR for local development
PGLITE_DATA_DIR=/path/to/your/eliza/.eliza

# Production PostgreSQL database connection
#POSTGRES_URL=postgresql://username:password@host:port/database_name

### SERVER CONFIGURATION ###
# Server settings for the agent runtime
NODE_ENV=production
ELIZA_UI_ENABLE=enable

### GOOGLE GENERATIVE AI MODEL CONFIGURATION ###
# Google GenAI API Key (required for Gemini models)
GOOGLE_GENERATIVE_AI_API_KEY=your-google-genai-api-key-here

# Model configuration - using Gemini 2.5 Flash for all models
GOOGLE_SMALL_MODE=gemini-2.5-flash
GOOGLE_LARGE_MODEL=gemini-2.5-flash
SMALL_MODEL=gemini-2.5-flash
LARGE_MODEL=gemini-2.5-flash

### TWITTER/X API CONFIGURATION ###
# ⚠️  IMPORTANT: Choose your data source carefully for legal compliance

## OPTION 1: Official Twitter/X API (RECOMMENDED for production)
# Use official Twitter API v2 for compliance with Twitter ToS
# Apply at: https://developer.twitter.com/
TWITTER_BEARER_TOKEN=your-official-twitter-bearer-token
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET_KEY=your-twitter-api-secret-key
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_TOKEN_SECRET=your-twitter-access-token-secret

# Twitter behavior settings
TWITTER_ENABLE_POST=false
TWITTER_POST_IMMEDIATELY=false

### DISCORD CONFIGURATION ###
# Discord API credentials for bot integration
DISCORD_APPLICATION_ID=your-discord-application-id
DISCORD_API_TOKEN=your-discord-api-token

# Channel restrictions (comma-separated list of Discord channel IDs)
# If not set, the bot operates in all channels
CHANNEL_IDS=channel_id_1,channel_id_2

### SENTIMENT ANALYSIS CONFIGURATION ###
# Watch terms for sentiment tracking (comma-separated)
# IMPORTANT: Use SINGLE keywords, hashtags (#example), mentions (@username), or exact phrases in quotes
# Multi-word searches often return EMPTY results on Twitter
# Examples: ai16z,elizaos,#crypto,@ai16zdao,"market crash"
# 
# ⚠️  PRIVACY NOTICE: Ensure your monitored terms comply with:
# - User privacy expectations
# - Platform content policies  
# - Applicable data protection laws (GDPR, CCPA, etc.)
SENTIMENT_WATCH_TERMS=ai16z,elizaos

### THIRD-PARTY DATA SERVICES ###
# ⚠️  WARNING: Third-party Twitter data services may violate Twitter ToS
# Use at your own risk - may result in Twitter account suspension
# Recommended for: Research, education, and proof-of-concept only

## OPTION 2: RapidAPI (Third-party - USE AT YOUR OWN RISK)
# Only use if you understand the legal implications
RAPIDAPI_APP_NAME=default-application_11000772
RAPIDAPI_API_KEY=your-rapidapi-key-here
RAPIDAPI_X_HOST=twitter241.p.rapidapi.com

# ⚠️  By using RapidAPI, you acknowledge:
# - This may violate Twitter's Terms of Service
# - You are solely responsible for compliance
# - Your Twitter account may be suspended
# - This is for educational/research purposes only

### DYNAMIC SCHEDULING INTERVALS ###
# Sentiment analysis scheduling configuration (in milliseconds)
SENTIMENT_NOMINAL_INTERVAL=3000000
# 1 hour (default)
SENTIMENT_MIN_INTERVAL=600000
# 10 minute minimum
SENTIMENT_MAX_INTERVAL=14400000
# 4 hours maximum

### SCHEDULING BEHAVIOR ###
# Advanced scheduling settings
SENTIMENT_BURST_THRESHOLD=2.0
# 200% traffic increase triggers burst mode
SENTIMENT_ENABLE_PREDICTIVE=true
# Enable time-based predictions
RAPIDAPI_COST_PER_CALL=0.001
# Cost tracking (default $0.001 per call)

### SECURITY CONFIGURATION ###
# Security salt for cryptographic operations (REQUIRED)
# ⚠️  SECURITY WARNING: Change this default value immediately
# Use a strong, unique random string for production deployments
SECRET_SALT=eliza-aoksdkasd-asdkasdlkasda-ouhasdajshdo

### DATA PROTECTION COMPLIANCE ###
# Ensure your deployment complies with applicable regulations:
# - Store API keys securely (never commit to version control)
# - Implement appropriate data retention policies
# - Respect user privacy and consent requirements
# - Follow platform-specific content and usage policies